# Copy to .env.local. Both are public (NEXT_PUBLIC_*) and baked in at build time.

# Portfolio API (the behind-azsh repo, an Encore app). Projects, people and
# images come from here. Without it the build falls back to 127.0.0.1:4000 and
# the portfolio, sitemap and llms.txt come out empty.
NEXT_PUBLIC_PORTFOLIO_API_URL=https://prod-behind-azsh-424i.encr.app

# Backend for the desktop's console challenge (util/session.ts).
NEXT_PUBLIC_API_URL=https://pesti.azsh.fi

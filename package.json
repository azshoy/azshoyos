    "desktop-check": "node scripts/desktop-check.mjs"
  },
  "dependencies": {
    "next": "15.1.9",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6"
  }
}
